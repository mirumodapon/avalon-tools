{
  "name": "avalon-tools",
  "version": "2.5.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "node scripts/build-all.ts",
    "preview": "node scripts/preview.ts",
    "lint": "oxlint && node scripts/check-catalog.ts && node scripts/check-boundaries.ts && node scripts/check-version.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -p scripts && pnpm -r run typecheck",
    "test": "vitest run",
    "icons": "node packages/pwa/scripts/icons.ts",
    "new:app": "node scripts/new-app.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.21.0"
}
