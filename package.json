{
  "name": "avalon-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @avalon/record dev",
    "build": "pnpm -r run build",
    "lint": "oxlint && node scripts/check-catalog.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2"
}
