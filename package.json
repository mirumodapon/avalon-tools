{
  "name": "avalon-tools",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "node scripts/build-all.ts",
    "preview": "node scripts/preview.ts",
    "lint": "oxlint && node scripts/check-catalog.ts && node scripts/check-boundaries.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "icons": "node packages/pwa/scripts/icons.ts"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2"
}
